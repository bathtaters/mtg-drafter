{
  "name": "mtg-drafter",
  "version": "2.3.4",
  "description": "Multi-player TCG draft simulator.",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3040",
    "build": "next build",
    "start": "next start -p 3040",
    "lint": "next lint",
    "test": "jest",
    "ssl": "npx local-ssl-proxy --key localhost-key.pem --cert localhost.pem --source 3041 --target 3040",
    "update": "git pull && npm install && npm update && prisma migrate deploy && prisma generate && npm run build && pm2 restart mtg-drafter --update-env"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@types/hoist-non-react-statics": "^3.3.1",
    "busboy": "^1.6.0",
    "daisyui": "^4.12.10",
    "dotenv": "^16.4.5",
    "mana-font": "^1.14.0",
    "nanoid": "^5.0.2",
    "next": "^14.2.5",
    "nookies": "^2.5.2",
    "react": "^18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.4",
    "socket.io": "^4.5.2",
    "socket.io-client": "^4.5.2",
    "stream-json": "^1.8.0",
    "swr": "^2.0.0",
    "zod": "^3.19.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/busboy": "^1.5.0",
    "@types/formidable": "^3.4.0",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.7",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "@types/stream-json": "^1.7.7",
    "autoprefixer": "^10.4.12",
    "eslint": "^8.24.0",
    "eslint-config-next": "^14.2.5",
    "jest": "^29.3.1",
    "jest-environment-jsdom": "^29.3.1",
    "mtggraphql": "^1.0.2",
    "postcss": "^8.4.16",
    "prisma": "^5.5.0",
    "tailwindcss": "^3.1.8",
    "tsx": "^4.16.5",
    "typescript": "^5.1.6"
  }
}
