{
  "name": "mtg-drafter",
  "version": "2.6.0",
  "description": "Multi-player TCG draft simulator.",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3040",
    "build": "podman build -t mtg-drafter .",
    "start": "podman run -d --name mtg-drafter -p 3040:3000 mtg-drafter",
    "stop": "podman stop mtg-drafter && podman rm mtg-drafter",
    "clean": "podman stop -i mtg-drafter && podman rm -i mtg-drafter && podman rmi mtg-drafter",
    "lint": "eslint",
    "test": "jest",
    "ssl": "npx local-ssl-proxy --key localhost-key.pem --cert localhost.pem --source 3041 --target 3040",
    "devdb": "cockroach start-single-node --insecure --store=path=\"$PWD/cockroach-data\" --listen-addr=localhost:26257 --http-addr=localhost:3045"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@types/hoist-non-react-statics": "^3.3.1",
    "busboy": "^1.6.0",
    "cookie": "^1.1.1",
    "daisyui": "^4.12.10",
    "dotenv": "^16.4.5",
    "mana-font": "^1.14.0",
    "nanoid": "^5.0.2",
    "next": "^15.5.18",
    "prom-client": "^15.1.3",
    "react": "^19.1.2",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.1.2",
    "sharp": "0.x.x",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stream-json": "^1.8.0",
    "zod": "^3.19.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/busboy": "^1.5.0",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@types/stream-json": "^1.7.7",
    "autoprefixer": "^10.4.12",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.18",
    "eslint-config-prettier": "^10.1.5",
    "jest": "^29.3.1",
    "jest-environment-jsdom": "^29.3.1",
    "postcss": "^8.4.16",
    "prettier": "^3.5.3",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.1.8",
    "tsx": "^4.16.5",
    "typescript": "^5.1.6"
  }
}
